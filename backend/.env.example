# Phase 0 contains no secrets. From Phase 2 onward, provider API keys (STT/TTS/LLM/
# telephony) go in `.env` (gitignored) and only ever appear here as CHANGEME.
#
# These are genuine working local-dev values for running `uvicorn`/`worker.py` outside
# Docker against the docker-compose services (which publish to the shifted host ports
# below because 5432/6379/8000 are commonly already bound on a dev machine).

DATABASE_URL=postgresql+asyncpg://callagent_app:callagent_app@localhost:55432/callagent
MIGRATION_DATABASE_URL=postgresql+asyncpg://callagent_migrator:callagent_migrator@localhost:55432/callagent
APP_DB_ROLE=callagent_app
REDIS_URL=redis://localhost:56379/0

ENVIRONMENT=development
DEBUG=false
# Frontend dev server origin (Vite default port) — required for browser-side fetches from
# frontend/ to succeed; defaults to [] (no origins allowed) otherwise.
CORS_ORIGINS=["http://localhost:5173"]

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=callagent-main

GLOBAL_OUTBOUND_ENABLED=true
CAMPAIGN_ENABLED=true
CLI_ENABLED=true
AI_AUTOMATION_ENABLED=true
HUMAN_FALLBACK_AVAILABLE=true

# Phase 2 — Conversation Layer. STT/TTS/LLM/telephony provider selection (voice/config.py) —
# demo-tier defaults; every alternative in each family is built as an adapter regardless.
# LLM_PROVIDER: "gemini" (default, $0 free tier) | "groq_llm" ($0 free tier) | "openai" (paid,
# added on request for whoever already holds an OpenAI key — not part of the $0 demo default).
STT_PROVIDER=whisper
TTS_PROVIDER=piper
LLM_PROVIDER=gemini
TELEPHONY_PROVIDER=browser
GROQ_API_KEY=CHANGEME
GEMINI_API_KEY=CHANGEME
OPENAI_API_KEY=CHANGEME

# The browser-demo transport has no real inbound call to trigger a workflow start, so
# voice_server.py starts a CallSessionWorkflow for a fixed demo customer/claim via the
# existing POST /calls endpoint — point these at seeded demo data (scripts/seed_demo_data.py).
VOICE_DEMO_CUSTOMER_ID=CHANGEME
VOICE_DEMO_CLAIM_ID=CHANGEME
BACKEND_BASE_URL=http://localhost:8001
